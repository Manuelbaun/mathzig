# 2. Export Matrix
m = [1.5, 2.5; 3.5, 4.5]
write_csv("tests/scripts/data/export_matrix.csv", m)

# 3. Export Record
r = { a: s, b: s * 10 }
write_csv("tests/scripts/data/export_record.csv", r)

# Verify Record
