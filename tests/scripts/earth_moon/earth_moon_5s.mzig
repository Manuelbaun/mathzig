mu_earth = 398600.4418;
mu_moon = 4902.800066;

earth_moon_2body(t, y) = [
  y[2];
  y[3];
  mu_moon * (y[4] - y[0]) / ((y[4] - y[0])^2 + (y[5] - y[1])^2)^(1.5);
  mu_moon * (y[5] - y[1]) / ((y[4] - y[0])^2 + (y[5] - y[1])^2)^(1.5);
  y[6];
  y[7];
  -mu_earth * (y[4] - y[0]) / ((y[4] - y[0])^2 + (y[5] - y[1])^2)^(1.5);
  -mu_earth * (y[5] - y[1]) / ((y[4] - y[0])^2 + (y[5] - y[1])^2)^(1.5)
];

y0 = [0; 0; 0; -0.00001257; 384400; 0; 0; 1.022];
sol = ode_solve_euler("earth_moon_2body", y0, [0, 10], 1);
[sol[10,1], sol[10,2], sol[10,5], sol[10,6]]
