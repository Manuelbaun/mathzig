    "setup": [
      "G = 6.67408e-11 m^3 / (kg * s^2)",
      "mbody = 5.9724e24 kg",
      "mu = G * mbody",
      "g0 = 9.80665 m/s^2",
      "r0 = 6371 km",
      "isp_sea = 282 s",
      "isp_vac = 311 s",
      "gamma0 = 89.99970 deg",
