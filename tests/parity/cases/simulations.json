      "m1 = 433100 kg",
      "m2 = 111500 kg",
      "m3 = 1700 kg",
      "mp = 5000 kg",
      "m0 = m1+m2+m3+mp",
      "dm = 2750 kg/s",
      "A = (3.66 m)^2 * pi",
      "dragCoef = 0.2",
      "mu_v = conv(mu, m^3/s^2)",
      "g0_v = conv(g0, m/s^2)",
      "r0_v = conv(r0, m)",
      "dm_v = conv(dm, kg/s)",
      "A_v = conv(A, m^2)",
      "isp_sea_v = conv(isp_sea, s)",
